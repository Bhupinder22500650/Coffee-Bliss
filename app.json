{
  "expo": {
    "name": "Coffee Bliss",
    "slug": "coffee-bliss",
    "scheme": "coffee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#201A18"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhupinder.coffeebliss"
    },
    "android": {
      "package": "com.bhupinder.coffeebliss",
      "versionCode": 1
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/logo.png" }
  }
}
